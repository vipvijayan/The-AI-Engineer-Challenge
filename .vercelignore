# Ignore virtual environment
api/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/

# Ignore development files
*.log
*.tmp
.DS_Store
.vscode/
.idea/

# Ignore test files
test.txt
*.test.py
tests/

# Ignore documentation
*.md
!README.md

# Exclude local virtualenvs and pip caches
api/venv/
api/.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Exclude alternative API implementations and backups so they are not uploaded as functions
api/index_node.js
api/simple_api.py
api/app.py
api/simple_app.py
api/test.py
api/package.json
api/.vercel

# Keep only the primary server file(s) we want deployed
!api/main.py
!api/vercel_entry.py

# Ignore git
.git/
.gitignore

# Ignore node_modules (handled by build process)
node_modules/
